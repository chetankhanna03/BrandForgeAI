NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Explicit offline text demo only; images/video and semantic-only rules cannot pass.
BRANDFORGE_DETERMINISTIC_ONLY=false
BRANDFORGE_FRONTEND_ORIGIN=http://localhost:3000
# Set true when serving through HTTPS; keep false for the local loopback demo.
BRANDFORGE_SECURE_COOKIE=false
